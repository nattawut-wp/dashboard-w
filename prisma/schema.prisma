// โครงสร้างฐานข้อมูล — แก้ไฟล์นี้แล้วรัน `npx prisma migrate dev` เพื่อสร้างตารางจริงใน Supabase

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// สถานะออร์เดอร์
enum OrderStatus {
  PENDING // รอชำระ
  PAID // ชำระแล้ว
  SHIPPED // จัดส่งแล้ว
  CANCELLED // ยกเลิก
}

/// บริษัทขนส่ง
enum ShippingCarrier {
  KERRY // Kerry Express
  FLASH // Flash Express
  JT // J&T Express
  THAILAND_POST // ไปรษณีย์ไทย
  OTHER // อื่นๆ
}

model Order {
  /// ใช้เป็นเลขออร์เดอร์ด้วย (แสดงเป็น #000123)
  id              Int              @id @default(autoincrement())
  customerName    String
  customerPhone   String?
  /// ยอดรวม (บาท) — กรอกเองในฟอร์ม (คลังสินค้าไม่มีราคา) ใช้ Decimal เพื่อไม่ให้ทศนิยมเพี้ยน
  total           Decimal          @db.Decimal(12, 2)
  status          OrderStatus      @default(PENDING)
  /// วันเวลาที่ลูกค้าสั่ง (ใช้ทำกราฟรายวัน)
  orderedAt       DateTime         @default(now()) @db.Timestamptz(3)
  note            String?
  /// ที่อยู่จัดส่ง — ไม่บังคับตอนสร้าง แต่ต้องมีก่อนบันทึกการจัดส่ง
  shippingAddress String?
  shippingCarrier ShippingCarrier?
  trackingNumber  String?
  /// วันเวลาที่ส่งของ (มีค่าเมื่อสถานะเป็น "จัดส่งแล้ว")
  shippedAt       DateTime?        @db.Timestamptz(3)
  items           OrderItem[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@index([orderedAt])
  @@index([status, orderedAt])
  @@map("orders")
}

/// สินค้าในคลัง
model Product {
  id                Int         @id @default(autoincrement())
  /// รหัสสินค้า (ห้ามซ้ำ)
  sku               String      @unique
  name              String
  /// จำนวนคงเหลือ — ห้ามติดลบ (มี CHECK ในฐานข้อมูลกันไว้อีกชั้น)
  stock             Int         @default(0)
  /// เหลือเท่านี้หรือน้อยกว่า = "ใกล้หมด"
  lowStockThreshold Int         @default(5)
  /// false = เลิกขาย (ซ่อนจากการเลือกในออร์เดอร์ แต่ออร์เดอร์เก่ายังอ้างถึงได้)
  isActive          Boolean     @default(true)
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  @@index([isActive, name])
  @@map("products")
}

/// สินค้าแต่ละรายการในออร์เดอร์
model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  /// ลบออร์เดอร์ → รายการถูกลบตาม
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  /// สินค้าที่เคยขายแล้วลบไม่ได้ (ใช้ "เลิกขาย" แทน)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// ชื่อสินค้า ณ ตอนที่ขาย — แก้ชื่อสินค้าทีหลัง ออร์เดอร์เก่าไม่เปลี่ยนตาม
  productName String
  quantity    Int

  /// สินค้าเดียวกันอยู่ในออร์เดอร์ได้แถวเดียว (เพิ่มจำนวนแทน)
  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

// ---- ตารางของระบบ login (Better Auth) ----
// สร้างด้วย `npx auth@1.7.17 generate` — ถ้าแก้ config ใน lib/auth/server.ts ให้สร้างใหม่ อย่าแก้มือ

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
