// โครงสร้างฐานข้อมูล — แก้ไฟล์นี้แล้วรัน `npx prisma migrate dev` เพื่อสร้างตารางจริงใน Supabase

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// สถานะออร์เดอร์
enum OrderStatus {
  PENDING   // รอชำระ
  PAID      // ชำระแล้ว
  SHIPPED   // จัดส่งแล้ว
  CANCELLED // ยกเลิก
}

model Order {
  /// ใช้เป็นเลขออร์เดอร์ด้วย (แสดงเป็น #000123)
  id            Int         @id @default(autoincrement())
  customerName  String
  customerPhone String?
  /// ยอดรวม (บาท) — ใช้ Decimal เพื่อไม่ให้ทศนิยมเพี้ยน
  total         Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(PENDING)
  /// วันเวลาที่ลูกค้าสั่ง (ใช้ทำกราฟรายวัน)
  orderedAt     DateTime    @default(now()) @db.Timestamptz(3)
  note          String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  @@index([orderedAt])
  @@index([status, orderedAt])
  @@map("orders")
}
